# OceanBase Database Configuration
# Your OceanBase database URL (e.g., "127.0.0.1:2881" or your cloud instance URL)
OB_URL="your-ob-url"

# Your OceanBase database username
OB_USER="your-ob-user"

# Your OceanBase database name
OB_DB_NAME="your-db-name"

# Your OceanBase database password
OB_PWD="your-pwd"

# Optional: Path to SSL CA certificate for secure connection
# Leave empty if not using SSL
OB_DB_SSL_CA_PATH=""

# Aliyun Dashscope API Key
# Visit https://www.aliyun.com/product/bailian to obtain the model service API key
DASHSCOPE_API_KEY="your-dashscope-api-key"

# Amap API Key
# Visit https://lbs.amap.com/ to obtain the map service API key
AMAP_API_KEY="your-amap-api-key"
